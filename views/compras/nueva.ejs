<%- include('../partials/layout-app-start', { title: 'Nueva Compra', activeNav: 'compras-nueva', headerSubtitle: 'Entrada de inventario' }) %>
<%- include('../partials/flash') %>

<div class="d-flex align-items-center justify-content-between mb-3">
  <h1 class="h4 mb-0">Nueva Compra</h1>
  <a href="/compras" class="btn btn-outline-secondary btn-sm">Volver</a>
</div>

<div class="card shadow-sm border-0 mb-3">
  <div class="card-body">
    <div class="row g-3">
      <div class="col-md-4">
        <label class="form-label small text-muted mb-1" for="proveedor">Proveedor *</label>
        <select id="proveedor" class="form-select">
          <option value="">Seleccione…</option>
          <% proveedores.forEach(function (p) { %>
            <option value="<%= p.id %>"><%= p.nombre %></option>
          <% }); %>
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label small text-muted mb-1" for="folio_factura">Folio / factura</label>
        <input type="text" id="folio_factura" class="form-control" placeholder="Opcional" />
      </div>
      <div class="col-md-2">
        <label class="form-label small text-muted mb-1" for="fecha_compra">Fecha</label>
        <input type="date" id="fecha_compra" class="form-control" value="<%= new Date().toISOString().slice(0,10) %>" />
      </div>
      <div class="col-md-3">
        <label class="form-label small text-muted mb-1" for="notas">Notas</label>
        <input type="text" id="notas" class="form-control" placeholder="Opcional" />
      </div>
    </div>
  </div>
</div>

<div class="position-relative mb-2">
  <input id="input-busqueda" type="text" class="form-control form-control-lg"
    placeholder="Busque o escanee un producto para agregarlo…" autocomplete="off" />
  <div id="resultados-busqueda" class="list-group position-absolute w-100 shadow-sm d-none" style="z-index: 1030;"></div>
</div>

<div class="card shadow-sm border-0 mb-3">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover table-sm mb-0 align-middle">
        <thead class="table-light">
          <tr>
            <th>Producto</th>
            <th style="width: 120px;" class="text-end">Cantidad</th>
            <th style="width: 130px;" class="text-end">Costo unitario</th>
            <th style="width: 130px;" class="text-end">Nuevo P. venta</th>
            <th style="width: 120px;" class="text-end">Subtotal</th>
            <th style="width: 44px;"></th>
          </tr>
        </thead>
        <tbody id="lineas-body">
          <tr id="lineas-vacio">
            <td colspan="6" class="text-center text-muted py-4">Sin productos — busque y agregue artículos.</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
  <div class="card-footer bg-white d-flex justify-content-between align-items-center">
    <span class="small text-muted">Pieza = entero · Granel = decimal (kg/m/L)</span>
    <span class="fs-5">Total: <strong id="total-display" class="text-primary">$0.00</strong></span>
  </div>
</div>

<div id="alerta-compra" class="alert alert-danger py-2 d-none" role="alert"></div>

<div class="d-flex gap-2">
  <button id="boton-guardar" type="button" class="btn btn-primary">Guardar compra</button>
  <a href="/compras" class="btn btn-outline-secondary">Cancelar</a>
</div>

<script>
(function () {
  'use strict';
  var lineas = []; // { productoId, nombre, es_granel, unidad_medida, cantidad, costo, nuevoPrecio, subtotal }

  var inputBusqueda = document.getElementById('input-busqueda');
  var resultadosEl = document.getElementById('resultados-busqueda');
  var lineasBody = document.getElementById('lineas-body');
  var totalDisplay = document.getElementById('total-display');
  var alertaCompra = document.getElementById('alerta-compra');

  function num(v) { var n = Number(v); return Number.isFinite(n) ? n : 0; }
  function r2(n) { return Math.round((n + Number.EPSILON) * 100) / 100; }
  function r3(n) { return Math.round((n + Number.EPSILON) * 1000) / 1000; }
  function fmt(n) { return '$' + n.toFixed(2); }

  function escapeHtml(s) {
    return String(s == null ? '' : s)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  function mostrarAlerta(msg) {
    alertaCompra.textContent = msg;
    alertaCompra.classList.remove('d-none');
  }
  function ocultarAlerta() { alertaCompra.classList.add('d-none'); }

  function total() {
    return r2(lineas.reduce(function (acc, l) { return acc + l.subtotal; }, 0));
  }

  function render() {
    lineasBody.innerHTML = '';
    if (!lineas.length) {
      var tr = document.createElement('tr');
      tr.id = 'lineas-vacio';
      tr.innerHTML = '<td colspan="6" class="text-center text-muted py-4">Sin productos — busque y agregue artículos.</td>';
      lineasBody.appendChild(tr);
    } else {
      lineas.forEach(function (l) {
        var tr = document.createElement('tr');
        var badge = l.es_granel ? ' <span class="badge bg-info text-dark ms-1">Granel</span>' : '';
        tr.innerHTML =
          '<td>' + escapeHtml(l.nombre) + badge + '</td>' +
          '<td class="text-end"><input type="number" class="form-control form-control-sm text-end cantidad-input" data-id="' + l.productoId + '" value="' + l.cantidad + '" step="' + (l.es_granel ? '0.001' : '1') + '" min="0.001" /></td>' +
          '<td class="text-end"><input type="number" class="form-control form-control-sm text-end costo-input" data-id="' + l.productoId + '" value="' + l.costo + '" step="0.01" min="0" /></td>' +
          '<td class="text-end"><input type="number" class="form-control form-control-sm text-end precio-input" data-id="' + l.productoId + '" value="' + (l.nuevoPrecio || '') + '" step="0.01" min="0" placeholder="—" /></td>' +
          '<td class="text-end fw-bold">' + fmt(l.subtotal) + '</td>' +
          '<td class="text-end"><button type="button" class="btn btn-sm btn-outline-danger quitar-linea" data-id="' + l.productoId + '">&times;</button></td>';
        lineasBody.appendChild(tr);
      });
    }
    totalDisplay.textContent = fmt(total());
  }

  function recalcular(id) {
    var l = lineas.find(function (x) { return x.productoId === id; });
    if (!l) return;
    l.subtotal = r2(l.cantidad * l.costo);
    render();
  }

  function agregar(producto) {
    var inv = (producto.inventarioSucursal && producto.inventarioSucursal.length) ? producto.inventarioSucursal[0] : null;
    if (!inv) { mostrarAlerta('Producto sin inventario en esta sucursal'); return; }

    if (lineas.some(function (x) { return x.productoId === producto.id; })) {
      mostrarAlerta('El producto ya está en la compra.');
      return;
    }

    var cantidad = producto.es_granel ? 1 : 1;
    var costo = num(inv.precio_compra) || 0;
    lineas.push({
      productoId: producto.id,
      nombre: producto.nombre,
      es_granel: producto.es_granel,
      unidad_medida: producto.unidad_medida,
      cantidad: cantidad,
      costo: costo,
      nuevoPrecio: '',
      subtotal: r2(cantidad * costo),
    });
    render();
  }

  function quitar(id) {
    lineas = lineas.filter(function (x) { return x.productoId !== id; });
    render();
  }

  function limpiarResultados() {
    resultadosEl.classList.add('d-none');
    resultadosEl.innerHTML = '';
  }

  async function buscar(q) {
    if (!q) { limpiarResultados(); return; }
    try {
      var res = await fetch('/ventas/api/buscar-productos?q=' + encodeURIComponent(q));
      var data = await res.json();
      var productos = data.productos || [];
      resultadosEl.innerHTML = '';
      if (!productos.length) { limpiarResultados(); return; }
      resultadosEl.classList.remove('d-none');
      productos.forEach(function (p) {
        var inv = (p.inventarioSucursal && p.inventarioSucursal.length) ? p.inventarioSucursal[0] : null;
        var b = document.createElement('button');
        b.type = 'button';
        b.className = 'list-group-item list-group-item-action d-flex justify-content-between align-items-center py-2';
        b.innerHTML = '<span>' + escapeHtml(p.nombre) + (p.es_granel ? ' <span class="badge bg-info text-dark">Granel</span>' : '') + '</span>' +
          '<span class="small text-muted">' + (inv ? ('costo ' + fmt(num(inv.precio_compra))) : '') + '</span>';
        b.addEventListener('click', function () { agregar(p); limpiarResultados(); inputBusqueda.value = ''; inputBusqueda.focus(); });
        resultadosEl.appendChild(b);
      });
    } catch (e) {
      mostrarAlerta('Error de búsqueda: ' + e.message);
    }
  }

  inputBusqueda.addEventListener('keydown', function (e) {
    if (e.key === 'Enter') {
      e.preventDefault();
      buscar(inputBusqueda.value.trim());
    }
  });

  lineasBody.addEventListener('change', function (e) {
    var id = e.target.dataset.id;
    var l = lineas.find(function (x) { return x.productoId === id; });
    if (!l) return;
    if (e.target.classList.contains('cantidad-input')) {
      var c = num(e.target.value);
      if (!l.es_granel) c = Math.round(c);
      l.cantidad = c <= 0 ? 0 : (l.es_granel ? r3(c) : c);
    } else if (e.target.classList.contains('costo-input')) {
      l.costo = num(e.target.value);
    } else if (e.target.classList.contains('precio-input')) {
      l.nuevoPrecio = num(e.target.value) > 0 ? num(e.target.value) : '';
    }
    recalcular(id);
  });

  lineasBody.addEventListener('click', function (e) {
    if (e.target.classList.contains('quitar-linea')) quitar(e.target.dataset.id);
  });

  document.addEventListener('click', function (e) {
    if (!resultadosEl.contains(e.target) && e.target !== inputBusqueda) limpiarResultados();
  });

  async function guardar() {
    ocultarAlerta();
    var proveedorId = document.getElementById('proveedor').value;
    if (!proveedorId) { mostrarAlerta('Seleccione un proveedor.'); return; }
    if (!lineas.length) { mostrarAlerta('Agregue al menos un producto.'); return; }

    var body = {
      proveedor_id: proveedorId,
      folio_factura: document.getElementById('folio_factura').value,
      fecha_compra: document.getElementById('fecha_compra').value,
      notas: document.getElementById('notas').value,
      items: lineas.map(function (l) {
        return {
          productoId: l.productoId,
          cantidad: l.cantidad,
          costo_unitario: l.costo,
          nuevo_precio_venta: l.nuevoPrecio || 0,
        };
      }),
    };

    var btn = document.getElementById('boton-guardar');
    btn.disabled = true;
    try {
      var res = await fetch('/compras', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      var data = await res.json();
      if (res.ok && data.ok) {
        window.location = '/compras/' + data.compra.id;
      } else {
        mostrarAlerta(data.error || 'No se pudo guardar la compra.');
      }
    } catch (e) {
      mostrarAlerta('Error de conexión: ' + e.message);
    } finally {
      btn.disabled = false;
    }
  }

  document.getElementById('boton-guardar').addEventListener('click', guardar);
})();
</script>

<%- include('../partials/layout-app-end') %>
