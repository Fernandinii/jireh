<%- include('../partials/layout-app-start', { title: 'Estado de Cuenta', activeNav: 'clientes', headerSubtitle: 'Fiado, abonos e historial' }) %>
<%- include('../partials/flash') %>

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
  <h1 class="h4 mb-0">Estado de cuenta</h1>
  <a href="/clientes" class="btn btn-outline-secondary btn-sm">Volver a clientes</a>
</div>

<div class="card shadow-sm border-0 mb-3">
  <div class="card-body">
    <label class="form-label small text-muted mb-1" for="cliente-select">Seleccione un cliente</label>
    <select id="cliente-select" class="form-select" onchange="if(this.value){ window.location='/clientes/abonos?cliente_id='+this.value; }">
      <option value="">— Seleccione —</option>
      <% clientes.forEach(function (c) { %>
        <option value="<%= c.id %>" <%= cliente && cliente.id === c.id ? 'selected' : '' %>>
          <%= c.nombre %><% if (Number(c.saldo_actual) > 0) { %> (adeuda $<%= Number(c.saldo_actual).toFixed(2) %>)<% } %>
        </option>
      <% }); %>
    </select>
  </div>
</div>

<% if (cliente) { %>
  <div class="row g-3 mb-3">
    <div class="col-sm-6 col-lg-3">
      <div class="card shadow-sm border-0 h-100">
        <div class="card-body">
          <div class="text-muted small text-uppercase">Cliente</div>
          <div class="fw-bold"><%= cliente.nombre %></div>
          <div class="small text-muted"><%= cliente.telefono || 'Sin teléfono' %></div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card shadow-sm border-0 h-100">
        <div class="card-body">
          <div class="text-muted small text-uppercase">Límite de crédito</div>
          <div class="fs-5 fw-bold">$<%= Number(cliente.limite_credito).toFixed(2) %></div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card shadow-sm border-0 h-100">
        <div class="card-body">
          <div class="text-muted small text-uppercase">Saldo pendiente</div>
          <div class="fs-4 fw-bold <%= Number(cliente.saldo_actual) > 0 ? 'text-danger' : 'text-success' %>">$<%= Number(cliente.saldo_actual).toFixed(2) %></div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card shadow-sm border-0 h-100">
        <div class="card-body">
          <div class="text-muted small text-uppercase">Crédito disponible</div>
          <div class="fs-5 fw-bold">$<%= (Number(cliente.limite_credito) > 0 ? Math.max(0, Number(cliente.limite_credito) - Number(cliente.saldo_actual)) : 0).toFixed(2) %></div>
        </div>
      </div>
    </div>
  </div>

  <div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white">
      <h2 class="h6 mb-0">Registrar abono</h2>
    </div>
    <div class="card-body">
      <form action="/clientes/<%= cliente.id %>/abonos" method="post" class="row g-2 align-items-end">
        <div class="col-md-3">
          <label class="form-label small text-muted mb-1" for="monto">Monto ($) *</label>
          <input type="number" class="form-control" id="monto" name="monto" step="0.01" min="0.01" required placeholder="0.00" />
        </div>
        <div class="col-md-3">
          <label class="form-label small text-muted mb-1" for="metodo_pago">Método de pago</label>
          <select class="form-select" id="metodo_pago" name="metodo_pago">
            <option value="efectivo">Efectivo</option>
            <option value="tarjeta">Tarjeta</option>
            <option value="transferencia">Transferencia</option>
          </select>
        </div>
        <div class="col-md-4">
          <label class="form-label small text-muted mb-1" for="notas">Notas</label>
          <input type="text" class="form-control" id="notas" name="notas" placeholder="Opcional" />
        </div>
        <div class="col-md-2">
          <button type="submit" class="btn btn-success w-100">Registrar</button>
        </div>
      </form>
    </div>
  </div>

  <div class="card shadow-sm border-0">
    <div class="card-header bg-white">
      <h2 class="h6 mb-0">Historial de movimientos</h2>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover table-sm mb-0 align-middle">
          <thead class="table-light">
            <tr>
              <th>Fecha</th>
              <th>Concepto</th>
              <th class="text-end">Cargo</th>
              <th class="text-end">Abono</th>
            </tr>
          </thead>
          <tbody>
            <% if (!historial.length) { %>
            <tr><td colspan="4" class="text-center text-muted py-4">Sin movimientos registrados.</td></tr>
            <% } %>
            <% historial.forEach(function (h) { %>
            <tr>
              <td class="small"><%= new Date(h.fecha).toLocaleString('es-MX') %></td>
              <td class="small">
                <%= h.descripcion %>
                <% if (h.tipo === 'venta') { %><span class="badge bg-warning text-dark ms-1">Venta</span><% } else { %><span class="badge bg-success ms-1">Abono</span><% } %>
              </td>
              <td class="text-end"><%= h.cargo > 0 ? '$' + h.cargo.toFixed(2) : '—' %></td>
              <td class="text-end text-success"><%= h.abono > 0 ? '-$' + h.abono.toFixed(2) : '—' %></td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
<% } else { %>
  <div class="card shadow-sm border-0">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover table-sm mb-0 align-middle">
          <thead class="table-light">
            <tr>
              <th>Cliente</th>
              <th>Teléfono</th>
              <th class="text-end">Saldo</th>
              <th class="text-end">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% if (!clientes.length) { %>
            <tr><td colspan="4" class="text-center text-muted py-4">No hay clientes registrados.</td></tr>
            <% } %>
            <% clientes.forEach(function (c) { %>
            <tr>
              <td class="fw-semibold"><%= c.nombre %></td>
              <td class="small text-muted"><%= c.telefono || '—' %></td>
              <td class="text-end">
                <% if (Number(c.saldo_actual) > 0) { %>
                  <span class="badge bg-danger">$<%= Number(c.saldo_actual).toFixed(2) %></span>
                <% } else { %>
                  <span class="badge bg-success">Al corriente</span>
                <% } %>
              </td>
              <td class="text-end">
                <a href="/clientes/abonos?cliente_id=<%= c.id %>" class="btn btn-sm btn-outline-primary">Ver cuenta</a>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
<% } %>

<%- include('../partials/layout-app-end') %>
