# Copiar a .env y ajustar valores
PORT=3000
HOST=127.0.0.1
SESSION_SECRET=una-cadena-larga-y-aleatoria-local
NODE_ENV=development
# SQL_LOG=1

# Solo si la BD no tiene usuarios (seed inicial)
# ADMIN_USER=admin
# ADMIN_PASS=admin123

# Sincronización Local-First (dejar CLOUD_SYNC_URL vacío = modo solo local)
CLOUD_SYNC_URL=
SYNC_API_KEY=
SYNC_INTERVAL_MS=15000
