<%- include('../partials/layout-app-start', { title: 'Ventas', activeNav: 'ventas', headerSubtitle: 'Historial de ventas' }) %>
<%- include('../partials/flash') %>

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
  <h1 class="h4 mb-0">Ventas del día</h1>
  <a href="/ventas/nueva" class="btn btn-success btn-sm">Nueva Venta (F1)</a>
</div>

<form class="row g-2 align-items-end mb-3" method="get" action="/ventas">
  <div class="col-auto">
    <label class="form-label small text-muted mb-0" for="fecha">Fecha</label>
    <input class="form-control form-control-sm" id="fecha" name="fecha" type="date" value="<%= fecha %>" />
  </div>
  <div class="col-auto">
    <label class="form-label small text-muted mb-0" for="tipo_pago">Tipo de pago</label>
    <select class="form-select form-select-sm" id="tipo_pago" name="tipo_pago">
      <option value="">Todos</option>
      <option value="contado" <%= tipoPago === 'contado' ? 'selected' : '' %>>Contado</option>
      <option value="credito" <%= tipoPago === 'credito' ? 'selected' : '' %>>Crédito</option>
    </select>
  </div>
  <div class="col-auto">
    <button type="submit" class="btn btn-sm btn-primary">Filtrar</button>
    <% if (fecha || tipoPago) { %>
      <a href="/ventas" class="btn btn-sm btn-outline-secondary">Limpiar</a>
    <% } %>
  </div>
</form>

<div class="card shadow-sm border-0">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover table-sm mb-0 align-middle">
        <thead class="table-light">
          <tr>
            <th>Folio</th>
            <th>Fecha / Hora</th>
            <th>Cajero</th>
            <th>Cliente</th>
            <th>Tipo de pago</th>
            <th class="text-end">Total</th>
            <th class="text-end"></th>
          </tr>
        </thead>
        <tbody>
          <% if (!ventas.length) { %>
          <tr>
            <td colspan="7" class="text-center text-muted py-4">No hay ventas registradas.</td>
          </tr>
          <% } %>
          <% ventas.forEach(function (v) { %>
          <tr>
            <td class="fw-bold">#<%= String(v.folio_local).padStart(4, '0') %></td>
            <td class="small"><%= new Date(v.fecha_venta).toLocaleString('es-MX') %></td>
            <td class="small"><%= v.usuario ? (v.usuario.nombre_completo || v.usuario.nombre_usuario) : '—' %></td>
            <td class="small"><%= v.cliente ? v.cliente.nombre : '—' %></td>
            <td>
              <% if (v.tipo_pago === 'credito') { %>
                <span class="badge bg-warning text-dark">Crédito</span>
              <% } else { %>
                <span class="badge bg-success">Contado</span>
              <% } %>
            </td>
            <td class="text-end fw-bold">$<%= Number(v.total).toFixed(2) %></td>
            <td class="text-end">
              <a href="/ventas/<%= v.id %>/ticket" target="_blank" class="btn btn-sm btn-outline-secondary">Ver Ticket</a>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <div class="px-3 pb-3">
      <%- include('../partials/pagination', { pagination: pagination, basePath: '/ventas', extraParams: { fecha: fecha, tipo_pago: tipoPago } }) %>
    </div>
  </div>
</div>

<%- include('../partials/layout-app-end') %>
