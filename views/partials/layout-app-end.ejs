    </div>
  </div>
</div>
<script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
<script>
  (function () {
    var badge = document.getElementById('sync-badge');
    if (!badge) return;
    var pend = document.getElementById('sync-pendientes');

    function update() {
      fetch('/api/sync/status', { headers: { Accept: 'application/json' } })
        .then(function (r) { return r.ok ? r.json() : Promise.reject(r.status); })
        .then(function (s) {
          var online = !!s.online;
          badge.className = 'badge border d-inline-flex align-items-center gap-1 ' +
            (online ? 'bg-success-subtle text-success' : 'bg-warning-subtle text-dark');
          badge.innerHTML = '<i class="bi ' + (online ? 'bi-cloud-check-fill' : 'bi-cloud-slash') + '"></i> ' +
            (online ? 'Nube conectada' : 'Modo Offline');

          var count = Number(s.pendientesCount) || 0;
          if (count > 0) {
            if (!pend) {
              pend = document.createElement('span');
              pend.id = 'sync-pendientes';
              pend.className = 'badge text-bg-info';
              pend.setAttribute('data-bs-toggle', 'tooltip');
              pend.title = 'Se subirán automáticamente al detectar conexión';
              badge.insertAdjacentElement('afterend', pend);
            }
            pend.textContent = count + ' pendientes';
          } else if (pend) {
            pend.remove();
            pend = null;
          }
        })
        .catch(function () { /* sin cambios si falla la petición */ });
    }

    update();
    setInterval(update, 15000);
  })();
</script>
</body>
</html>
