<%- include('../partials/layout-app-start', { title: 'Proveedores', activeNav: 'proveedores', headerSubtitle: 'Contactos de compra' }) %>
<%- include('../partials/flash') %>

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
  <h1 class="h4 mb-0">Proveedores</h1>
  <a href="/proveedores/nuevo" class="btn btn-success btn-sm">+ Nuevo Proveedor</a>
</div>

<form class="row g-2 align-items-end mb-3" method="get" action="/proveedores">
  <div class="col-sm-6 col-md-4 col-lg-3">
    <label class="form-label small text-muted mb-0" for="q">Buscar (nombre, contacto o teléfono)</label>
    <input class="form-control form-control-sm" id="q" name="q" type="search" value="<%= pagination.q %>" placeholder="Ej. Distribuidora..." autocomplete="off" />
  </div>
  <div class="col-auto">
    <label class="form-label small text-muted mb-0" for="perPage">Por página</label>
    <select class="form-select form-select-sm" id="perPage" name="perPage" onchange="this.form.submit()">
      <% [10, 25, 50, 100].forEach(function (n) { %>
        <option value="<%= n %>" <%= pagination.perPage === n ? 'selected' : '' %>><%= n %></option>
      <% }); %>
    </select>
  </div>
  <div class="col-auto">
    <input type="hidden" name="page" value="1" />
    <button type="submit" class="btn btn-sm btn-primary">Buscar</button>
    <% if (pagination.q) { %>
      <a href="/proveedores?perPage=<%= pagination.perPage %>" class="btn btn-sm btn-outline-secondary">Limpiar</a>
    <% } %>
  </div>
</form>

<div class="card shadow-sm border-0">
  <div class="card-body p-0">
    <table class="table table-hover table-sm mb-0 align-middle">
      <thead class="table-light">
        <tr>
          <th>Nombre</th>
          <th>Contacto</th>
          <th>Teléfono</th>
          <th>Email</th>
          <th class="text-end">Productos</th>
          <th class="text-end">Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% if (!proveedores.length) { %>
        <tr><td colspan="6" class="text-center text-muted py-4">No hay proveedores que coincidan.</td></tr>
        <% } %>
        <% proveedores.forEach(function (p) { %>
        <tr>
          <td class="fw-semibold"><%= p.nombre %></td>
          <td class="small text-muted"><%= p.contacto || '—' %></td>
          <td class="small"><%= p.telefono || '—' %></td>
          <td class="small"><%= p.email || '—' %></td>
          <td class="text-end"><span class="badge bg-secondary"><%= p.productos ? p.productos.length : 0 %></span></td>
          <td class="text-end text-nowrap">
            <a href="/proveedores/<%= p.id %>/editar" class="btn btn-sm btn-outline-primary">Editar</a>
            <form action="/proveedores/<%= p.id %>?_method=DELETE" method="post" class="d-inline"
              onsubmit="return confirm('¿Desactivar el proveedor \'<%= p.nombre %>\'?');">
              <button type="submit" class="btn btn-sm btn-outline-danger">Desactivar</button>
            </form>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
    <div class="px-3 pb-3">
      <%- include('../partials/pagination', { pagination: pagination, basePath: '/proveedores' }) %>
    </div>
  </div>
</div>

<%- include('../partials/layout-app-end') %>
