<%- include('../partials/layout-app-start', { title: title, activeNav: activeNav, headerSubtitle: isEdit ? 'Editar producto' : 'Alta de producto' }) %>
<%- include('../partials/flash') %>

<div class="d-flex align-items-center justify-content-between mb-3">
  <h1 class="h4 mb-0"><%= title %></h1>
  <a href="/productos" class="btn btn-outline-secondary btn-sm">Volver al catálogo</a>
</div>

<% if (error) { %>
  <div class="alert alert-danger"><%= error %></div>
<% } %>

<form action="<%= formAction %><%= isEdit ? '?_method=PUT' : '' %>" method="post" class="card shadow-sm border-0">
  <div class="card-body">

    <div class="row g-3">
      <div class="col-md-4">
        <label class="form-label" for="codigo_barras">Código de barras</label>
        <input type="text" class="form-control" id="codigo_barras" name="codigo_barras"
          value="<%= producto.codigo_barras || '' %>" placeholder="Escanea o deja vacío" autocomplete="off" />
        <div class="form-text">Pulsa Enter para saltar a Nombre (el formulario no se enviará).</div>
      </div>
      <div class="col-md-8">
        <label class="form-label" for="nombre">Nombre *</label>
        <input type="text" class="form-control" id="nombre" name="nombre" value="<%= producto.nombre || '' %>" required />
      </div>

      <div class="col-md-6">
        <label class="form-label" for="categoria_id">Categoría</label>
        <div class="input-group">
          <select class="form-select" id="categoria_id" name="categoria_id">
            <option value="">— Sin categoría —</option>
            <% categorias.forEach(function (c) { %>
              <option value="<%= c.id %>" <%= producto.categoria_id === c.id ? 'selected' : '' %>><%= c.nombre %></option>
            <% }); %>
          </select>
          <a class="btn btn-outline-secondary" href="/productos/categorias" target="_blank" title="Crear categoría">+</a>
        </div>
      </div>

      <div class="col-md-6">
        <label class="form-label d-block">Tipo de venta</label>
        <div class="form-check form-switch">
          <input class="form-check-input" type="checkbox" role="switch" id="es_granel" name="es_granel" value="1"
            <%= producto.es_granel ? 'checked' : '' %> />
          <label class="form-check-label" for="es_granel">Venta a granel (permite fracciones)</label>
        </div>
      </div>

      <div class="col-md-3">
        <label class="form-label" for="unidad_medida">Unidad de medida</label>
        <select class="form-select" id="unidad_medida" name="unidad_medida" <%= producto.es_granel ? '' : 'disabled' %>>
          <% ['kg', 'g', 'litro', 'ml', 'metro'].forEach(function (u) { %>
            <option value="<%= u %>" <%= producto.unidad_medida === u ? 'selected' : '' %>><%= u %></option>
          <% }); %>
        </select>
      </div>

      <div class="col-md-3">
        <label class="form-label" for="precio_compra">Precio compra</label>
        <input type="number" class="form-control" id="precio_compra" name="precio_compra" step="0.01" min="0"
          value="<%= inventario.precio_compra != null && inventario.precio_compra !== '' ? inventario.precio_compra : '' %>" />
      </div>

      <div class="col-md-3">
        <label class="form-label" for="precio_venta">Precio venta</label>
        <input type="number" class="form-control" id="precio_venta" name="precio_venta" step="0.01" min="0"
          value="<%= inventario.precio_venta != null && inventario.precio_venta !== '' ? inventario.precio_venta : '' %>" />
      </div>

      <div class="col-md-3 d-flex align-items-end">
        <div class="small w-100">
          <span class="text-muted">Margen:</span>
          <span id="margen-porcentaje" class="fw-bold text-success">—</span>
          <span class="text-muted d-block small">Ganancia: <span id="margen-ganancia">—</span></span>
        </div>
      </div>

      <div class="col-md-3">
        <label class="form-label" for="stock">Stock actual</label>
        <input type="number" class="form-control" id="stock" name="stock" step="1" min="0"
          value="<%= inventario.stock != null && inventario.stock !== '' ? inventario.stock : '' %>" />
      </div>

      <div class="col-md-3">
        <label class="form-label" for="stock_minimo">Stock mínimo</label>
        <input type="number" class="form-control" id="stock_minimo" name="stock_minimo" step="1" min="0"
          value="<%= inventario.stock_minimo != null && inventario.stock_minimo !== '' ? inventario.stock_minimo : '' %>" />
      </div>

      <div class="col-12">
        <label class="form-label d-block">Proveedores asociados</label>
        <% if (!proveedores.length) { %>
          <div class="text-muted small">No hay proveedores registrados. <a href="/proveedores/nuevo" target="_blank">Crear proveedor</a></div>
        <% } else { %>
          <div class="row">
            <% proveedores.forEach(function (p) { %>
              <div class="col-sm-6 col-md-4 col-lg-3">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="proveedor_ids" id="prov_<%= p.id %>" value="<%= p.id %>"
                    <%= proveedorIds.includes(p.id) ? 'checked' : '' %> />
                  <label class="form-check-label" for="prov_<%= p.id %>"><%= p.nombre %></label>
                </div>
              </div>
            <% }); %>
          </div>
        <% } %>
      </div>
    </div>
  </div>
  <div class="card-footer bg-white d-flex gap-2">
    <button type="submit" class="btn btn-primary"><%= isEdit ? 'Guardar cambios' : 'Crear producto' %></button>
    <a href="/productos" class="btn btn-outline-secondary">Cancelar</a>
  </div>
</form>

<script>
  (function () {
    var esGranel = document.getElementById('es_granel');
    var unidad = document.getElementById('unidad_medida');
    var stock = document.getElementById('stock');
    var stockMinimo = document.getElementById('stock_minimo');
    var precioCompra = document.getElementById('precio_compra');
    var precioVenta = document.getElementById('precio_venta');
    var margenPct = document.getElementById('margen-porcentaje');
    var margenGan = document.getElementById('margen-ganancia');
    var codigo = document.getElementById('codigo_barras');

    function num(v) { var n = Number(v); return Number.isFinite(n) ? n : 0; }

    function aplicarGranel() {
      var on = esGranel.checked;
      unidad.disabled = !on;
      var step = on ? '0.001' : '1';
      stock.step = step;
      stockMinimo.step = step;
      if (!on) unidad.value = 'pieza';
    }

    function calcMargen() {
      var pc = num(precioCompra.value);
      var pv = num(precioVenta.value);
      if (pc > 0 && pv >= 0) {
        var pct = ((pv - pc) / pc) * 100;
        margenPct.textContent = (pct >= 0 ? '+' : '') + pct.toFixed(2) + '%';
        margenPct.classList.toggle('text-danger', pct < 0);
        margenPct.classList.toggle('text-success', pct >= 0);
        margenGan.textContent = '$' + (pv - pc).toFixed(2);
      } else {
        margenPct.textContent = '—';
        margenGan.textContent = '—';
      }
    }

    esGranel.addEventListener('change', aplicarGranel);
    precioCompra.addEventListener('input', calcMargen);
    precioVenta.addEventListener('input', calcMargen);

    // El escáner termina con Enter; no enviar el formulario, saltar a Nombre.
    codigo.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        document.getElementById('nombre').focus();
      }
    });

    aplicarGranel();
    calcMargen();
  })();
</script>

<%- include('../partials/layout-app-end') %>
