<%- include('../partials/layout-app-start', { title: 'Clientes', activeNav: 'clientes', headerSubtitle: 'Fiado y cuentas por cobrar' }) %>
<%- include('../partials/flash') %>

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
  <h1 class="h4 mb-0">Clientes</h1>
  <div class="d-flex align-items-center gap-2">
    <a href="/clientes/abonos" class="btn btn-outline-primary btn-sm">Control de Abonos</a>
    <a href="/clientes/nuevo" class="btn btn-success btn-sm">+ Nuevo Cliente</a>
  </div>
</div>

<div class="row g-3 mb-3">
  <div class="col-sm-6 col-lg-3">
    <div class="card shadow-sm border-0">
      <div class="card-body">
        <div class="text-muted small text-uppercase">Total por cobrar</div>
        <div class="fs-4 fw-bold <%= totalPorCobrar > 0 ? 'text-danger' : 'text-success' %>">$<%= totalPorCobrar.toFixed(2) %></div>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-lg-3">
    <div class="card shadow-sm border-0">
      <div class="card-body">
        <div class="text-muted small text-uppercase">Clientes activos</div>
        <div class="fs-4 fw-bold"><%= pagination.total %></div>
      </div>
    </div>
  </div>
</div>

<form class="row g-2 align-items-end mb-3" method="get" action="/clientes">
  <div class="col-sm-6 col-md-4 col-lg-3">
    <label class="form-label small text-muted mb-0" for="q">Buscar (nombre o teléfono)</label>
    <input class="form-control form-control-sm" id="q" name="q" type="search" value="<%= pagination.q %>" placeholder="Ej. Juan o 555..." autocomplete="off" />
  </div>
  <div class="col-auto d-flex align-items-end gap-1 pb-1">
    <input class="form-check-input" id="con_adeudo" name="con_adeudo" type="checkbox" value="1" <%= conAdeudo ? 'checked' : '' %> />
    <label class="form-check-label small text-muted" for="con_adeudo">Solo con adeudo</label>
  </div>
  <div class="col-auto">
    <label class="form-label small text-muted mb-0" for="perPage">Por página</label>
    <select class="form-select form-select-sm" id="perPage" name="perPage" onchange="this.form.submit()">
      <% [10, 25, 50, 100].forEach(function (n) { %>
        <option value="<%= n %>" <%= pagination.perPage === n ? 'selected' : '' %>><%= n %></option>
      <% }); %>
    </select>
  </div>
  <div class="col-auto">
    <input type="hidden" name="page" value="1" />
    <button type="submit" class="btn btn-sm btn-primary">Buscar</button>
    <% if (pagination.q || conAdeudo) { %>
      <a href="/clientes?perPage=<%= pagination.perPage %>" class="btn btn-sm btn-outline-secondary">Limpiar</a>
    <% } %>
  </div>
</form>

<div class="card shadow-sm border-0">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover table-sm mb-0 align-middle">
        <thead class="table-light">
          <tr>
            <th>Nombre</th>
            <th>Teléfono</th>
            <th class="text-end">Límite crédito</th>
            <th class="text-end">Saldo actual</th>
            <th class="text-end">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% if (!clientes.length) { %>
          <tr><td colspan="5" class="text-center text-muted py-4">No hay clientes que coincidan.</td></tr>
          <% } %>
          <% clientes.forEach(function (c) {
               const saldo = Number(c.saldo_actual);
               const limite = Number(c.limite_credito);
          %>
          <tr>
            <td class="fw-semibold"><%= c.nombre %></td>
            <td class="small text-muted"><%= c.telefono || '—' %></td>
            <td class="text-end">$<%= limite.toFixed(2) %></td>
            <td class="text-end">
              <% if (saldo > 0) { %>
                <span class="badge bg-danger">$<%= saldo.toFixed(2) %></span>
              <% } else { %>
                <span class="badge bg-success">Al corriente</span>
              <% } %>
            </td>
            <td class="text-end text-nowrap">
              <a href="/clientes/<%= c.id %>" class="btn btn-sm btn-outline-primary">Cuenta</a>
              <a href="/clientes/abonos?cliente_id=<%= c.id %>" class="btn btn-sm btn-outline-success">Abonar</a>
              <a href="/clientes/<%= c.id %>/editar" class="btn btn-sm btn-outline-secondary">Editar</a>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <div class="px-3 pb-3">
      <%- include('../partials/pagination', { pagination: pagination, basePath: '/clientes', extraParams: { con_adeudo: conAdeudo ? '1' : '' } }) %>
    </div>
  </div>
</div>

<%- include('../partials/layout-app-end') %>
