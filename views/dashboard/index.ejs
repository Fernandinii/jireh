<%- include('../partials/layout-app-start', { title: 'Inicio', activeNav: 'dashboard', headerSubtitle: 'Panel principal' }) %>
<%- include('../partials/flash') %>

<h1 class="h4 mb-3">Panel de Control</h1>

<div class="row g-3 mb-4">
  <div class="col-sm-6 col-xl-3">
    <div class="card h-100 shadow-sm border-0">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <p class="text-muted small mb-1">Total Productos</p>
            <h3 class="mb-0 fw-bold"><%= totalProductos %></h3>
          </div>
          <span class="badge bg-primary fs-6"><%= totalProductos %></span>
        </div>
        <a href="/productos" class="stretched-link"></a>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-xl-3">
    <div class="card h-100 shadow-sm border-0">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <p class="text-muted small mb-1">Stock Bajo</p>
            <h3 class="mb-0 fw-bold <%= productosBajosStock > 0 ? 'text-warning' : '' %>"><%= productosBajosStock %></h3>
          </div>
          <span class="badge bg-warning text-dark fs-6"><%= productosBajosStock %></span>
        </div>
        <a href="/productos" class="stretched-link"></a>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-xl-3">
    <div class="card h-100 shadow-sm border-0">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <p class="text-muted small mb-1">Clientes Activos</p>
            <h3 class="mb-0 fw-bold"><%= totalClientes %></h3>
          </div>
          <span class="badge bg-success fs-6"><%= totalClientes %></span>
        </div>
        <a href="/clientes" class="stretched-link"></a>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-xl-3">
    <div class="card h-100 shadow-sm border-0">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <p class="text-muted small mb-1">Ventas Hoy</p>
            <h3 class="mb-0 fw-bold">$<%= ventasHoy.toFixed(2) %></h3>
          </div>
          <span class="badge bg-info text-dark fs-6">$<%= ventasHoy.toFixed(0) %></span>
        </div>
        <a href="/ventas" class="stretched-link"></a>
      </div>
    </div>
  </div>
</div>

<% if (bajosStock.length > 0) { %>
<div class="card shadow-sm border-0 mb-4">
  <div class="card-header bg-white d-flex justify-content-between align-items-center py-2">
    <span class="fw-semibold small">Productos con stock bajo</span>
    <span class="badge bg-warning text-dark"><%= bajosStock.length %> productos</span>
  </div>
  <div class="card-body p-0">
    <table class="table table-hover table-sm mb-0 align-middle">
      <thead class="table-light">
        <tr>
          <th>Producto</th>
          <th class="text-end">Stock actual</th>
          <th class="text-end">Stock mínimo</th>
          <th>Unidad</th>
        </tr>
      </thead>
      <tbody>
        <% bajosStock.forEach(function (p) { %>
        <tr class="<%= p.stock === 0 ? 'table-danger' : 'table-warning' %>">
          <td><%= p.nombre %></td>
          <td class="text-end fw-bold"><%= p.stock %></td>
          <td class="text-end"><%= p.stock_minimo %></td>
          <td><%= p.unidad_medida || 'pieza' %></td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>
<% } else { %>
<div class="alert alert-success py-2 small">
  Todos los productos tienen stock suficiente.
</div>
<% } %>

<%- include('../partials/layout-app-end') %>
