<%- include('../partials/layout-app-start', { title: 'Nueva Venta', activeNav: 'ventas-nueva', headerSubtitle: 'Punto de venta' }) %>
<%- include('../partials/flash') %>

<div class="row g-3 align-items-start">
  <!-- ===== Columna izquierda: captura rápida ===== -->
  <div class="col-12 col-xl-8">
    <div class="position-relative mb-2">
      <input id="input-busqueda" type="text" class="form-control form-control-lg"
        placeholder="Escanee código de barras o busque por nombre…" autocomplete="off" />
      <div id="resultados-busqueda" class="list-group position-absolute w-100 shadow-sm d-none" style="z-index: 1030;"></div>
    </div>

    <div class="card shadow-sm border-0">
      <div class="card-body p-0">
        <div class="table-responsive" style="max-height: 52vh; overflow-y: auto;">
          <table class="table table-hover table-sm mb-0 align-middle">
            <thead class="table-light">
              <tr>
                <th style="width: 110px;">Código</th>
                <th>Producto</th>
                <th style="width: 110px;" class="text-end">Cantidad</th>
                <th style="width: 100px;" class="text-end">Precio</th>
                <th style="width: 110px;" class="text-end">Subtotal</th>
                <th style="width: 44px;"></th>
              </tr>
            </thead>
            <tbody id="carrito-body">
              <tr id="carrito-vacio">
                <td colspan="6" class="text-center text-muted py-4">Carrito vacío — escanee o busque un producto.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
      <div class="card-footer bg-white small text-muted d-flex justify-content-between">
        <span>F2 o Ctrl+Enter para cobrar</span>
        <span>Piezas = cantidad entera · Granel = decimal (kg/m/L)</span>
      </div>
    </div>

    <div id="alerta-caja" class="alert alert-danger py-2 mt-2 d-none" role="alert"></div>
  </div>

  <!-- ===== Columna derecha: panel de cobro ===== -->
  <div class="col-12 col-xl-4">
    <div class="card shadow-sm border-0 mb-3">
      <div class="card-body text-center">
        <div class="text-muted small text-uppercase">Total a pagar</div>
        <div id="total-display" class="display-3 fw-bold">$0.00</div>
      </div>
    </div>

    <div class="card shadow-sm border-0 mb-3">
      <div class="card-body">
        <label class="form-label small text-muted mb-1">Tipo de pago</label>
        <select id="tipo-pago" class="form-select">
          <option value="contado">Contado</option>
          <option value="credito">Fiado (Crédito)</option>
        </select>
      </div>
    </div>

    <!-- Contado -->
    <div id="panel-contado" class="card shadow-sm border-0 mb-3">
      <div class="card-body">
        <label class="form-label small text-muted mb-1" for="monto-recibido">Monto recibido</label>
        <input id="monto-recibido" type="number" step="0.01" min="0" class="form-control form-control-lg text-end" placeholder="0.00" />
        <div class="d-flex gap-1 flex-wrap mt-2">
          <button type="button" class="btn btn-sm btn-outline-secondary" data-monto="exacto">Exacto</button>
          <button type="button" class="btn btn-sm btn-outline-secondary" data-monto="50">$50</button>
          <button type="button" class="btn btn-sm btn-outline-secondary" data-monto="100">$100</button>
          <button type="button" class="btn btn-sm btn-outline-secondary" data-monto="200">$200</button>
          <button type="button" class="btn btn-sm btn-outline-secondary" data-monto="500">$500</button>
        </div>
        <hr class="my-2" />
        <div class="d-flex justify-content-between align-items-center">
          <span class="text-muted">Cambio</span>
          <span id="cambio-display" class="fw-bold fs-5">$0.00</span>
        </div>
      </div>
    </div>

    <!-- Fiado -->
    <div id="panel-fiado" class="card shadow-sm border-0 mb-3 d-none">
      <div class="card-body">
        <label class="form-label small text-muted mb-1" for="cliente-select">Cliente (fiado)</label>
        <select id="cliente-select" class="form-select">
          <option value="">Seleccione un cliente…</option>
          <% clientes.forEach(function (c) { %>
          <option value="<%= c.id %>" data-saldo="<%= Number(c.saldo_actual) %>" data-limite="<%= Number(c.limite_credito) %>">
            <%= c.nombre %> (saldo $<%= Number(c.saldo_actual).toFixed(2) %>)
          </option>
          <% }); %>
        </select>
        <div id="cliente-info" class="small text-muted mt-2"></div>
      </div>
    </div>

    <button id="boton-confirmar" type="button" class="btn btn-success btn-lg w-100 py-3 fw-bold">
      Cobrar (F2)
    </button>
  </div>
</div>

<!-- ===== Modal Granel ===== -->
<div class="modal" id="modal-granel" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header py-2">
        <h5 class="modal-title">Producto a granel</h5>
        <button type="button" class="btn-close" data-cerrar="modal-granel"></button>
      </div>
      <div class="modal-body">
        <div id="granel-nombre" class="fw-bold mb-1"></div>
        <div class="small text-muted mb-3">
          Precio: <span id="granel-precio"></span> / <span id="granel-unidad"></span> ·
          Disponible: <span id="granel-stock"></span> <span id="granel-unidad-stock"></span>
        </div>
        <div class="mb-2">
          <label class="form-label small text-muted mb-1" for="granel-peso">Cantidad (<span id="granel-unidad-label">kg</span>)</label>
          <input id="granel-peso" type="number" step="0.001" min="0" class="form-control form-control-lg" placeholder="0.000" />
        </div>
        <div>
          <label class="form-label small text-muted mb-1" for="granel-importe">O importe en pesos ($)</label>
          <input id="granel-importe" type="number" step="0.01" min="0" class="form-control form-control-lg" placeholder="0.00" />
        </div>
      </div>
      <div class="modal-footer py-2">
        <button type="button" class="btn btn-outline-secondary" data-cerrar="modal-granel">Cancelar</button>
        <button type="button" id="granel-confirmar" class="btn btn-primary">Agregar</button>
      </div>
    </div>
  </div>
</div>

<!-- ===== Modal Éxito ===== -->
<div class="modal" id="modal-exito" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered modal-sm">
    <div class="modal-content text-center">
      <div class="modal-body p-4">
        <div class="fs-3 mb-2">Venta registrada</div>
        <div class="text-muted small mb-3">Folio <span id="exito-folio"></span></div>
        <div class="border rounded p-3 mb-3">
          <div class="text-muted small">Cambio a entregar</div>
          <div id="exito-cambio" class="display-6 fw-bold">$0.00</div>
        </div>
        <div class="d-grid gap-2">
          <button type="button" id="btn-imprimir" class="btn btn-primary">Imprimir Ticket</button>
          <button type="button" id="btn-nueva-venta" class="btn btn-outline-secondary">Nueva Venta</button>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="/js/pos.js"></script>
<%- include('../partials/layout-app-end') %>
