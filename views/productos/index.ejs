<%- include('../partials/layout-app-start', { title: 'Productos', activeNav: 'productos', headerSubtitle: 'Catálogo e inventario' }) %>
<%- include('../partials/flash') %>

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
  <h1 class="h4 mb-0">Productos</h1>
  <div class="d-flex align-items-center gap-2">
    <span class="badge bg-secondary">Paginación: máx. <%= pagination.perPage %> por página</span>
    <a href="/productos/categorias" class="btn btn-outline-primary btn-sm">Categorías</a>
    <a href="/productos/nuevo" class="btn btn-success btn-sm">+ Nuevo Producto</a>
  </div>
</div>

<form class="row g-2 align-items-end mb-3" method="get" action="/productos">
  <div class="col-sm-6 col-md-4 col-lg-3">
    <label class="form-label small text-muted mb-0" for="q">Buscar (nombre o código)</label>
    <input class="form-control form-control-sm" id="q" name="q" type="search"
      value="<%= pagination.q %>" placeholder="Ej. arroz o 750..." autocomplete="off" />
  </div>
  <div class="col-auto">
    <label class="form-label small text-muted mb-0" for="categoria_id">Categoría</label>
    <select class="form-select form-select-sm" id="categoria_id" name="categoria_id">
      <option value="">Todas</option>
      <% categorias.forEach(function (c) { %>
        <option value="<%= c.id %>" <%= categoriaId === c.id ? 'selected' : '' %>><%= c.nombre %></option>
      <% }); %>
    </select>
  </div>
  <div class="col-auto d-flex align-items-end gap-1 pb-1">
    <input class="form-check-input" id="solo_granel" name="solo_granel" type="checkbox" value="1" <%= soloGranel ? 'checked' : '' %> />
    <label class="form-check-label small text-muted" for="solo_granel">Solo granel</label>
  </div>
  <div class="col-auto d-flex align-items-end gap-1 pb-1">
    <input class="form-check-input" id="stock_bajo" name="stock_bajo" type="checkbox" value="1" <%= stockBajo ? 'checked' : '' %> />
    <label class="form-check-label small text-muted" for="stock_bajo">Solo stock bajo</label>
  </div>
  <div class="col-auto">
    <label class="form-label small text-muted mb-0" for="perPage">Por página</label>
    <select class="form-select form-select-sm" id="perPage" name="perPage" onchange="this.form.submit()">
      <% [10, 25, 50, 100].forEach(function (n) { %>
        <option value="<%= n %>" <%= pagination.perPage === n ? 'selected' : '' %>><%= n %></option>
      <% }); %>
    </select>
  </div>
  <div class="col-auto">
    <input type="hidden" name="page" value="1" />
    <button type="submit" class="btn btn-sm btn-primary">Buscar</button>
    <% if (pagination.q || categoriaId || soloGranel || stockBajo) { %>
      <a href="/productos?perPage=<%= pagination.perPage %>" class="btn btn-sm btn-outline-secondary">Limpiar</a>
    <% } %>
  </div>
</form>

<div class="card shadow-sm border-0">
  <div class="card-body p-0">
    <div class="productos-table-wrap table-sticky-wrap">
      <table class="table table-hover table-sm mb-0 align-middle">
        <thead class="table-light">
          <tr>
            <th scope="col">Nombre</th>
            <th scope="col">Código</th>
            <th scope="col">Categoría</th>
            <th scope="col" class="text-end">Precio compra</th>
            <th scope="col" class="text-end">Precio venta</th>
            <th scope="col" class="text-end">Stock</th>
            <th scope="col" class="text-end">Mín.</th>
            <th scope="col">Unidad</th>
            <th scope="col">Proveedor</th>
            <th scope="col" class="text-end">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% if (!productos.length) { %>
          <tr>
            <td colspan="10" class="text-center text-muted py-4">No hay productos que coincidan.</td>
          </tr>
          <% } %>
          <% productos.forEach(function (prod) {
               const inv = prod.inventarioSucursal && prod.inventarioSucursal.length ? prod.inventarioSucursal[0] : null;
               const pc = inv ? Number(inv.precio_compra) : NaN;
               const pv = inv ? Number(inv.precio_venta) : NaN;
               const stock = inv ? Number(inv.stock) : NaN;
               const minimo = inv ? Number(inv.stock_minimo) : NaN;
               const stockBajo = inv && stock <= minimo;
          %>
          <tr>
            <td>
              <%= prod.nombre %>
              <% if (prod.es_granel) { %><span class="badge bg-info text-dark ms-1">Granel</span><% } %>
            </td>
            <td><code class="small"><%= prod.codigo_barras || '—' %></code></td>
            <td>
              <% if (prod.categoria) { %>
                <span class="badge" style="background-color:<%= prod.categoria.color_hex || '#6c757d' %>"><%= prod.categoria.nombre %></span>
              <% } else { %>
                <span class="text-muted small">—</span>
              <% } %>
            </td>
            <td class="text-end"><%= isNaN(pc) ? '—' : pc.toFixed(2) %></td>
            <td class="text-end"><%= isNaN(pv) ? '—' : pv.toFixed(2) %></td>
            <td class="text-end">
              <%= isNaN(stock) ? '—' : stock %>
              <% if (stockBajo) { %><span class="badge bg-danger ms-1" title="Stock bajo">Bajo</span><% } %>
            </td>
            <td class="text-end"><%= isNaN(minimo) ? '—' : minimo %></td>
            <td><%= prod.unidad_medida || 'pieza' %></td>
            <td class="small text-muted"><%= prod.proveedores && prod.proveedores.length ? prod.proveedores.map(p => p.nombre).join(', ') : '—' %></td>
            <td class="text-end text-nowrap">
              <a href="/productos/<%= prod.id %>/editar" class="btn btn-sm btn-outline-primary">Editar</a>
              <form action="/productos/<%= prod.id %>?_method=DELETE" method="post" class="d-inline"
                onsubmit="return confirm('¿Desactivar el producto \'<%= prod.nombre %>\'?');">
                <button type="submit" class="btn btn-sm btn-outline-danger">Desactivar</button>
              </form>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <div class="px-3 pb-3">
      <%- include('../partials/pagination', { pagination: pagination, basePath: '/productos', extraParams: { categoria_id: categoriaId, solo_granel: soloGranel ? '1' : '', stock_bajo: stockBajo ? '1' : '' } }) %>
    </div>
  </div>
</div>

<p class="text-muted small mt-3 mb-0">
  La tabla usa scroll vertical suave dentro de la ventana para no alargar toda la página; el servidor solo envía <%= pagination.perPage %> filas por petición.
</p>

<%- include('../partials/layout-app-end') %>
